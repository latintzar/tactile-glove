  "schema": "synthetic-piezo-stft-reconstruction-2",
  "date": "2026-11-03",
  "author": "Peter Neyra",
  "caption": "Synthetic reconstruction.",
  "reported_observation": "Peter reported successful visual differences between aluminium, wood and sandpaper in his piezo experiment. Sandpaper had the largest bright feature in the middle of the frequency range; wood a small thin feature; aluminium an intermediate feature.",
  "figure_evidence": "Actual STFTs of deterministic generated one-dimensional signals, saved as PCM WAV and read back before analysis.",
  "numerical_scope": "All signal samples, frequencies, durations, amplitudes, filter parameters and plotted levels are synthetic. The material models illustrate the recalled hierarchy.",
  "reference_image": {
    "filename": "codex-clipboard-31793026-c0ba-4d98-9256-6d1cf242f6d7.png",
    "sha256": "1956f50bb48f51ec021720dbb00604faba7836008007dd156119d2b32a55e959",
    "role": "Viewed spectrogram appearance/layout reference: dark blue floor, cyan/green/yellow energy, time horizontal, frequency vertical."
  },
  "method": {
    "signal": "Seeded time-domain excitation, resonators and bandpass filters, contact-stroke envelopes, low-frequency rumble and brief transients",
    "analysis": "1024-sample Hann STFT with 128-sample hop at 16000 samples/s; one-sided interior magnitudes doubled, DC/Nyquist unchanged",
    "scale": "Shared simulated 0\u20138000 Hz, 0\u201344 s and -96\u20130 dBFS scale"
  },
