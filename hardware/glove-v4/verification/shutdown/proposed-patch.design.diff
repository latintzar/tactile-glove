+    esp_restart();
+  }
+  // Owners have stopped DMA/SPI and acknowledged; now execute the existing
+  // ordered camera and SD rail-off sequence under busMutex, checking writes.
+  if (!cameraStopAck || !storageStopAck) return;
+  if (!output(CAM_PWDN, CAM_RESET) || !output(0, CAM_IF)) { controlFaults++; io0ResetFailoff(); esp_restart(); }
+  // ... existing waits and checked rail sequence ...
+}
