+static void bootPeripheralQuiesce() {
  // Runs at the first app entry after a timeout restart, before IO0 release.
  holdSdPinsLow();
  periph_module_disable(PERIPH_SPI3_MODULE);
  ledc_stop(LEDC_LOW_SPEED_MODE, LEDC_CHANNEL_0, 0);
  for (int pin : {6,7,8,9,10,11,12,13,15,16,17,18}) {
    gpio_reset_pin(gpio_num_t(pin));
    gpio_set_direction(gpio_num_t(pin), GPIO_MODE_INPUT);
  }
  gpio_reset_pin(gpio_num_t(Pins::io0Reset));
  gpio_set_level(gpio_num_t(Pins::io0Reset), 0);
  gpio_pullup_dis(gpio_num_t(Pins::io0Reset));
  gpio_pulldown_en(gpio_num_t(Pins::io0Reset));
  gpio_set_direction(gpio_num_t(Pins::io0Reset), GPIO_MODE_OUTPUT);
}
static bool io0Release() {
+  gpio_set_level(gpio_num_t(Pins::io0Reset), 1);
+  vTaskDelay(pdMS_TO_TICKS(1));
+  return true; // first I2C register writes remain the qualification check
+}
+static void io0ResetFailoff() {
+  gpio_set_level(gpio_num_t(Pins::io0Reset), 0);
+  // Only call this after both worker acknowledgements. Timeout recovery uses
+  // esp_restart() first; bootPeripheralQuiesce() runs after reset. Software
+  // reset does not guarantee GPIO3 becomes high-Z.
+}
