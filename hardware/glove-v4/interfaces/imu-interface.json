  "devices": [
    {
      "id": 0,
      "role": "cuff-camera",
      "address": 106,
      "ref": "U_IMU_CUFF",
      "mount": "Cuff PCB fixed rigidly to camera seat. Keep antenna/converter heat away. The camera-to-cuff transform is calibrated once after assembly."
    },
    {
      "id": 1,
      "role": "dorsal-hand",
      "address": 107,
      "ref": "U_IMU_HAND",
      "mount": "Thin rigid tile in keyed soft pocket over third metacarpal, clear of knuckles. Arrow toward middle finger; plug toward wrist. The hand can move relative to the cuff at the wrist."
    }
  ],
  "acquisition": {
    "bus_hz": 400000,
    "odr_hz": 833,
    "accelerometer_full_scale_g": 4,
    "gyroscope_full_scale_dps": 1000,
    "accelerometer_mg_per_lsb": 0.122,
    "gyroscope_mdps_per_lsb": 35,
    "timestamp_tick_us": 25,
    "timestamp_batch_decimation": 8,
    "fifo_record_bytes": 7,
    "fifo_capacity_records": 512,
    "fifo_capacity_wire_bytes": 3584,
    "fifo_read": "Long auto-increment burst 0x78..0x7e wrapping to0x78, ST AN5398 section4.7.1",
    "poll_interval_target_ms": 10,
    "use_hand_irq": false,
    "temperature": "Record sensor raw temperature and calibration temperature; manufacturer nominal256LSB/C and25Czero are not a calibrated skin temperature measurement."
  },
  "harness": {
    "stock_cable": "Adafruit4210",
    "source": "https://www.adafruit.com/product/4210",
    "length_mm": 100,
    "connector_each_end": "JST SH 4pin female, keyed",
    "pin_order": {
      "1": "GND black",
      "2": "3V3_SYS red",
      "3": "I2C_SDA blue",
      "4": "I2C_SCL yellow"
    },
    "routing": "Run above the back of the wrist in a fabric tunnel. Leave a shallow S loop for flexion; fasten the cable jacket8mm behind both plugs. Keep it away from high impedance PVDF leads. Disconnect power before plugging.",
    "factory_test": "Check every conductor pin1-to-pin1 throughpin4-to-pin4 and for adjacent shorts; do not infer continuity from wire colour alone."
  },
  "bus_budget": {
    "main_pullup_ohm": 2200,
    "camera_pullup_ohm": 2200,
    "capacitance_budget_pf": 150,
    "pullup_tolerance_fraction": 0.01,
    "allocation_pf": {
      "two_imus_and_expanders": 45,
      "traces_connectors_and_levelshifter": 35,
      "100mm_harness": 30,
      "camera_side_reflected_and_margin": 40
    },
    "note": "Capacitance allocations are design limits; verify the final routed/harness total against the300ns fast-mode rise-time limit. No extra pullups on the hand tile."
