    "pad1_topview": "upper-left; pins1..4 downleft,5..7bottom,8..11upright,12..14top right-to-left",
    "supply_decoupling_distance_mm_max": 1.5,
    "connector_at": "wrist-facing edge",
    "mechanics": "Soft cover only over the rigid tile. No assembly glue, screw or enclosure point load on the MEMS package. The tile pocket keys rotation and has a visible toward-fingers arrow."
  },
  "calibration": {
    "per_unit": "Boot ID/readback, factory self-test under ST procedure; six-orientation accelerometer calibration; stationary gyro offset with sensor temperature; axis/sign fixture verification; camera intrinsics/extrinsics; offset/clock fit stored with serial number.",
    "runtime": "Retain raw samples and metadata; FIFO overrun, clock gaps, saturation and transport loss are explicit. Quiet motion tests inform stationary probability; contact pressure alone is not a zero-velocity measurement.",
    "tracking": "A separate cuff-camera trajectory and hand orientation are estimated. Wrist flexion invalidates a fixed camera-to-hand transform. Blind position uncertainty grows until a visual/known-contact constraint becomes available."
  }
